generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Program {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  parentName String
  type       String
  alliance   String?
  region     String[]
  badgeBg    String
  badgeText  String
  priority   Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  statusTiers   StatusTier[]
  deals         Deal[]
  opportunities EarningOpportunity[]
  userStatuses  UserProgramStatus[]
  balances      PortfolioBalance[]
}

model StatusTier {
  id                String   @id @default(cuid())
  programId         String
  code              String
  name              String
  rank              Int
  earningMultiplier Float    @default(1.0)
  qualificationType String   @default("miles")
  requiredMiles     Int?
  requiredSegments  Int?
  requiredSpendEur  Int?
  periodMonths      Int      @default(12)
  benefits          String[]
  color             String   @default("#1D9E75")
  isActive          Boolean  @default(true)

  program      Program             @relation(fields: [programId], references: [id])
  userStatuses UserProgramStatus[]

  @@unique([programId, code])
}

model UserProgramStatus {
  id                        String    @id @default(cuid())
  email                     String
  programId                 String
  currentTierId             String?
  currentQualifyingMiles    Int       @default(0)
  currentQualifyingSegments Int       @default(0)
  currentQualifyingSpend    Int       @default(0)
  tierValidUntil            DateTime?
  updatedAt                 DateTime  @updatedAt
  createdAt                 DateTime  @default(now())

  program     Program     @relation(fields: [programId], references: [id])
  currentTier StatusTier? @relation(fields: [currentTierId], references: [id])

  @@unique([email, programId])
}

model Deal {
  id           String    @id @default(cuid())
  programId    String
  title        String
  description  String
  type         String
  milesMax     Int?
  bonusPercent Int?
  sourceUrl    String
  affiliateUrl String?
  expiresAt    DateTime?
  isVerified   Boolean   @default(false)
  isHot        Boolean   @default(false)
  isActive     Boolean   @default(true)
  detectedAt   DateTime  @default(now())

  program    Program    @relation(fields: [programId], references: [id])
  alertsSent AlertLog[]
}

model EarningOpportunity {
  id                 String   @id @default(cuid())
  programId          String
  title              String
  type               String
  milesEstimate      Int
  milesPerMonth      Int?
  confidenceScore    Int      @default(50)
  budgetRequired     Int?
  monthStart         Int      @default(1)
  isPriority         Boolean  @default(false)
  isLocked           Boolean  @default(false)
  region             String[] @default(["WORLDWIDE"])
  notes              String?
  requiredStatusCode String?
  unlockedByStatus   Boolean  @default(false)
  isActive           Boolean  @default(true)

  program Program @relation(fields: [programId], references: [id])
}

model ClientProfile {
  id        String   @id @default(cuid())
  email     String   @unique
  firstName String?
  lastName  String?

  country           String  @default("FR")
  region            String  @default("EU")

  hasAmexGold       Boolean @default(false)
  hasAmexPlatine    Boolean @default(false)
  hasVisaInfinite   Boolean @default(false)
  hasMarriottCard   Boolean @default(false)
  hasHiltonCard     Boolean @default(false)
  hasAirlineCard    Boolean @default(false)
  hasChaseCard      Boolean @default(false)
  hasCitiCard       Boolean @default(false)

  monthlySpendEur   Int     @default(1000)
  flightsPerYear    Int     @default(4)
  preferredCabin    String  @default("business")

  // Situation bancaire
  mainBank          String?
  annualIncomeRange String?
  hasExistingAmex   Boolean @default(false)
  isHomeowner       Boolean @default(false)

  // Comportement de voyage
  mainAirline       String?
  travelType        String?
  departureCity     String?

  // Statuts programmes
  flyingBlueStatus  String?
  aviosStatus       String?
  marriottStatus    String?
  hiltonStatus      String?

  // Historique de demandes de cartes
  newCardsLast24Months Int  @default(0)

  // Dépenses par catégorie (euros/mois)
  spendTravel       Int     @default(0)
  spendDining       Int     @default(0)
  spendGroceries    Int     @default(0)
  spendOnline       Int     @default(0)
  spendOther        Int     @default(0)

  // Voyage
  homeAirport           String?
  nextTripDestination   String?
  nextTripDate          DateTime?
  nextTripCabin         String?

  // Soldes principaux
  flyingBlueBalance Int     @default(0)
  aviosBalance      Int     @default(0)
  amexMRBalance     Int     @default(0)

  targetProgramCode String?
  targetMiles       Int?
  deadlineMonths    Int?
  budgetMonthly     Int?

  balances     PortfolioBalance[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PortfolioBalance {
  id        String    @id @default(cuid())
  email     String
  programId String
  balance   Int       @default(0)
  expiresAt DateTime?
  updatedAt DateTime  @updatedAt

  profile ClientProfile @relation(fields: [email], references: [email])
  program Program       @relation(fields: [programId], references: [id])

  @@unique([email, programId])
}

model UserAlert {
  id         String   @id @default(cuid())
  email      String
  firstName  String?
  programIds String[]
  threshold  Int      @default(30)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  logs AlertLog[]
}

model AlertLog {
  id      String   @id @default(cuid())
  alertId String
  dealId  String
  sentAt  DateTime @default(now())

  alert UserAlert @relation(fields: [alertId], references: [id])
  deal  Deal      @relation(fields: [dealId], references: [id])

  @@unique([alertId, dealId])
}
